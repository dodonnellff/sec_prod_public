$ErrorActionPreference = "Stop"

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

$DaysBack = 30

$RequiredScopes = @(
    "AuditLog.Read.All"
    "User.Read.All"
)

$RequiredModules = @(
    "Microsoft.Graph.Authentication"
    "Microsoft.Graph.Reports"
    "Microsoft.Graph.Users"
)

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

function ConvertTo-ReportDate {
    [CmdletBinding()]
    param(
        [Parameter()]
        $DateValue
    )

    if (
        $null -eq $DateValue -or
        [string]::IsNullOrWhiteSpace([string]$DateValue)
    ) {
        return "Never"
    }

    try {
        $ParsedDate = [datetimeoffset]::Parse(
            [string]$DateValue,
            [System.Globalization.CultureInfo]::InvariantCulture
        )

        return $ParsedDate.ToLocalTime().ToString(
            "yyyy-MM-dd HH:mm:ss zzz"
        )
    }
    catch {
        return [string]$DateValue
    }
}

function Get-TargetedNonInteractiveSignIns {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$UserId,

        [Parameter(Mandatory)]
        [datetime]$StartDate
    )

    $StartDateText = $StartDate.ToUniversalTime().ToString(
        "yyyy-MM-ddTHH:mm:ssZ"
    )

    $Filter = (
        "userId eq '{0}' and " +
        "createdDateTime ge {1} and " +
        "status/errorCode eq 0 and " +
        "signInEventTypes/any(t:t eq 'nonInteractiveUser')"
    ) -f $UserId, $StartDateText

    $SelectProperties = @(
        "id"
        "createdDateTime"
        "userId"
        "userPrincipalName"
        "location"
        "status"
        "signInEventTypes"
    ) -join ","

    $EncodedFilter = [uri]::EscapeDataString($Filter)

    $RequestUri = (
        "https://graph.microsoft.com/beta/auditLogs/signIns" +
        "?`$filter=$EncodedFilter" +
        "&`$select=$SelectProperties" +
        "&`$top=1000"
    )

    $Records = [System.Collections.Generic.List[object]]::new()
    $PageNumber = 0

    while (-not [string]::IsNullOrWhiteSpace($RequestUri)) {
        $PageNumber++

        Write-Host (
            "    Retrieving targeted non-interactive page {0}..." -f
            $PageNumber
        ) -ForegroundColor DarkCyan

        $Response = Invoke-MgGraphRequest `
            -Method GET `
            -Uri $RequestUri `
            -OutputType PSObject `
            -ErrorAction Stop

        foreach ($Record in @($Response.value)) {
            $Country = $Record.location.countryOrRegion

            if ([string]::IsNullOrWhiteSpace($Country)) {
                $Country = "Unknown"
            }
            else {
                $Country = $Country.Trim().ToUpperInvariant()
            }

            $Records.Add(
                [PSCustomObject]@{
                    Id                = $Record.id
                    CreatedDateTime   = $Record.createdDateTime
                    UserId            = $Record.userId
                    UserPrincipalName = $Record.userPrincipalName
                    Country           = $Country
                }
            )
        }

        $RequestUri = $Response.'@odata.nextLink'
    }

    return $Records.ToArray()
}

function Export-ReportCsv {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [object[]]$Report,

        [Parameter(Mandatory)]
        [string[]]$Columns,

        [Parameter(Mandatory)]
        [string]$Path,

        [Parameter(Mandatory)]
        [string]$ReportName
    )

    $Rows = @(
        $Report |
            Sort-Object -Property "User Name" |
            Select-Object -Property $Columns
    )

    if ($Rows.Count -gt 0) {
        $Rows |
            Export-Csv `
                -LiteralPath $Path `
                -NoTypeInformation `
                -Encoding UTF8 `
                -Force
    }
    else {
        $EmptyRow = [ordered]@{}

        foreach ($Column in $Columns) {
            $EmptyRow[$Column] = $null
        }

        [PSCustomObject]$EmptyRow |
            Export-Csv `
                -LiteralPath $Path `
                -NoTypeInformation `
                -Encoding UTF8 `
                -Force

        $CsvContent = @(
            Get-Content -LiteralPath $Path
        )

        if ($CsvContent.Count -gt 0) {
            Set-Content `
                -LiteralPath $Path `
                -Value $CsvContent[0] `
                -Encoding UTF8
        }
    }

    Write-Host (
        "{0}: {1:N0} users" -f
        $ReportName,
        $Rows.Count
    ) -ForegroundColor Green

    Write-Host "Output: $Path" -ForegroundColor Green
}

# ---------------------------------------------------------------------------
# Check and install required modules
# ---------------------------------------------------------------------------

$MissingModules = @(
    foreach ($ModuleName in $RequiredModules) {
        if (-not (Get-Module -ListAvailable -Name $ModuleName)) {
            $ModuleName
        }
    }
)

if ($MissingModules.Count -gt 0) {
    Write-Host "Installing required Microsoft Graph modules..." `
        -ForegroundColor Yellow

    foreach ($ModuleName in $MissingModules) {
        Write-Host "Installing $ModuleName..." `
            -ForegroundColor Yellow

        Install-Module `
            -Name $ModuleName `
            -Scope CurrentUser `
            -Repository PSGallery `
            -Force `
            -AllowClobber `
            -ErrorAction Stop
    }
}

Import-Module Microsoft.Graph.Authentication -ErrorAction Stop
Import-Module Microsoft.Graph.Reports -ErrorAction Stop
Import-Module Microsoft.Graph.Users -ErrorAction Stop

# ---------------------------------------------------------------------------
# Request and validate client code
# ---------------------------------------------------------------------------

do {
    $ClientCode = (
        Read-Host "Enter the Client Code"
    ).Trim().ToUpperInvariant()

    if ([string]::IsNullOrWhiteSpace($ClientCode)) {
        Write-Warning "Client Code cannot be blank."
        $ClientCodeIsValid = $false
    }
    elseif ($ClientCode -notmatch '^[A-Z0-9_-]+$') {
        Write-Warning (
            "Client Code may only contain letters, numbers, underscores, " +
            "and hyphens."
        )

        $ClientCodeIsValid = $false
    }
    else {
        $ClientCodeIsValid = $true
    }
}
until ($ClientCodeIsValid)

# ---------------------------------------------------------------------------
# Build output paths
# ---------------------------------------------------------------------------

$OutputDirectory = Join-Path `
    -Path "C:\Temp" `
    -ChildPath $ClientCode

$AllUsersOutputPath = Join-Path `
    -Path $OutputDirectory `
    -ChildPath "UserSignInReport.csv"

$MembersOutputPath = Join-Path `
    -Path $OutputDirectory `
    -ChildPath "UserSignInReport-Members.csv"

$InactiveUsersOutputPath = Join-Path `
    -Path $OutputDirectory `
    -ChildPath "UserSignInReport-Inactive-Users.csv"

$GuestsUnknownOutputPath = Join-Path `
    -Path $OutputDirectory `
    -ChildPath "UserSignInReport-Guests-Unknown.csv"

$ExceptionsOutputPath = Join-Path `
    -Path $OutputDirectory `
    -ChildPath "UserSignInReport-Exceptions.csv"

$SingleCountryExceptionsOutputPath = Join-Path `
    -Path $OutputDirectory `
    -ChildPath "UserSignInReport-Single-Country-Exceptions.csv"

$TwoCountryAustraliaOutputPath = Join-Path `
    -Path $OutputDirectory `
    -ChildPath "UserSignInReport-Two-Countries-Including-AU.csv"

if (-not (Test-Path -LiteralPath $OutputDirectory)) {
    New-Item `
        -Path $OutputDirectory `
        -ItemType Directory `
        -Force `
        -ErrorAction Stop |
        Out-Null
}

Write-Host ""
Write-Host "Client Code: $ClientCode" -ForegroundColor Cyan
Write-Host "Sign-in report period: Last $DaysBack days" `
    -ForegroundColor Cyan
Write-Host "Output directory: $OutputDirectory" `
    -ForegroundColor Cyan
Write-Host ""

# ---------------------------------------------------------------------------
# Connect once using WAM
# ---------------------------------------------------------------------------

try {
    Write-Host "Connecting to Microsoft Graph..." `
        -ForegroundColor Cyan

    Connect-MgGraph `
        -Scopes $RequiredScopes `
        -ContextScope Process `
        -NoWelcome `
        -ErrorAction Stop

    $GraphContext = Get-MgContext

    if (-not $GraphContext) {
        throw (
            "Microsoft Graph authentication did not return a valid context."
        )
    }

    Write-Host (
        "Connected to Microsoft Graph as {0}" -f
        $GraphContext.Account
    ) -ForegroundColor Green

    # -----------------------------------------------------------------------
    # Retrieve Entra users and sign-in activity
    # -----------------------------------------------------------------------

    Write-Host ""
    Write-Host "Retrieving Entra users and last sign-in activity..." `
        -ForegroundColor Cyan

    $Users = @(
        Get-MgUser `
            -All `
            -Property @(
                "Id"
                "DisplayName"
                "UserPrincipalName"
                "UserType"
                "UsageLocation"
                "AccountEnabled"
                "SignInActivity"
            ) `
            -ConsistencyLevel eventual `
            -CountVariable UserCount `
            -ErrorAction Stop
    )

    $UserLookup = @{}

    foreach ($User in $Users) {
        $UserLookup[$User.Id] = $User
    }

    Write-Host (
        "Retrieved {0:N0} Entra users." -f
        $Users.Count
    ) -ForegroundColor Green

    # -----------------------------------------------------------------------
    # Set reporting-period start date
    # -----------------------------------------------------------------------

    $StartDate = (
        Get-Date
    ).ToUniversalTime().AddDays(-$DaysBack)

    $StartDateFilter = $StartDate.ToString(
        "yyyy-MM-ddTHH:mm:ssZ"
    )

    # -----------------------------------------------------------------------
    # Retrieve successful interactive sign-ins
    # -----------------------------------------------------------------------

    $InteractiveFilter = (
        "createdDateTime ge {0} and " +
        "status/errorCode eq 0 and " +
        "isInteractive eq true"
    ) -f $StartDateFilter

    Write-Host ""
    Write-Host (
        "Retrieving successful interactive sign-ins since {0} UTC..." -f
        $StartDate.ToString("yyyy-MM-dd HH:mm:ss")
    ) -ForegroundColor Cyan

    $InteractiveSignIns = @(
        Get-MgAuditLogSignIn `
            -All `
            -Filter $InteractiveFilter `
            -Property @(
                "Id"
                "CreatedDateTime"
                "UserId"
                "UserDisplayName"
                "UserPrincipalName"
                "Location"
                "Status"
                "IsInteractive"
            ) `
            -ErrorAction Stop
    )

    Write-Host (
        "Retrieved {0:N0} successful interactive sign-ins." -f
        $InteractiveSignIns.Count
    ) -ForegroundColor Green

    # -----------------------------------------------------------------------
    # Normalise interactive sign-ins
    # -----------------------------------------------------------------------

    $NormalisedInteractiveSignIns = @(
        foreach ($SignIn in $InteractiveSignIns) {
            if (
                [string]::IsNullOrWhiteSpace(
                    $SignIn.UserId
                )
            ) {
                continue
            }

            $Country = $SignIn.Location.CountryOrRegion

            if ([string]::IsNullOrWhiteSpace($Country)) {
                $Country = "Unknown"
            }
            else {
                $Country = $Country.Trim().ToUpperInvariant()
            }

            [PSCustomObject]@{
                Id                = $SignIn.Id
                CreatedDateTime   = $SignIn.CreatedDateTime
                UserId            = $SignIn.UserId
                UserDisplayName   = $SignIn.UserDisplayName
                UserPrincipalName = $SignIn.UserPrincipalName
                Country           = $Country
            }
        }
    )

    # -----------------------------------------------------------------------
    # Create interactive sign-in lookup by user ID
    # -----------------------------------------------------------------------

    $InteractiveSignInsByUserId = @{}

    foreach (
        $UserGroup in (
            $NormalisedInteractiveSignIns |
                Group-Object -Property UserId
        )
    ) {
        $InteractiveSignInsByUserId[$UserGroup.Name] = @(
            $UserGroup.Group
        )
    }

    # -----------------------------------------------------------------------
    # Identify enabled Members
    # -----------------------------------------------------------------------

    $EnabledMembers = @(
        $Users |
            Where-Object {
                $_.UserType -eq "Member" -and
                $_.AccountEnabled -eq $true
            }
    )

    Write-Host ""
    Write-Host (
        "Found {0:N0} enabled Member accounts." -f
        $EnabledMembers.Count
    ) -ForegroundColor Green

    # -----------------------------------------------------------------------
    # Identify users requiring targeted non-interactive lookup
    # -----------------------------------------------------------------------

    $TargetUsers = @(
        foreach ($Member in $EnabledMembers) {
            $MemberId = $Member.Id

            if (
                $InteractiveSignInsByUserId.ContainsKey(
                    $MemberId
                )
            ) {
                $InteractiveCount = @(
                    $InteractiveSignInsByUserId[$MemberId]
                ).Count
            }
            else {
                $InteractiveCount = 0
            }

            $LastNonInteractiveValue = (
                $Member.SignInActivity.LastNonInteractiveSignInDateTime
            )

            $HasLastNonInteractiveValue = -not (
                [string]::IsNullOrWhiteSpace(
                    [string]$LastNonInteractiveValue
                )
            )

            $LastNonInteractiveWithinPeriod = $false

            if ($HasLastNonInteractiveValue) {
                try {
                    $LastNonInteractiveDate = (
                        [datetimeoffset]::Parse(
                            [string]$LastNonInteractiveValue,
                            [System.Globalization.CultureInfo]::InvariantCulture
                        )
                    ).UtcDateTime

                    $LastNonInteractiveWithinPeriod = (
                        $LastNonInteractiveDate -ge $StartDate
                    )
                }
                catch {
                    $LastNonInteractiveWithinPeriod = $false
                }
            }

            if (
                $InteractiveCount -eq 0 -and
                $HasLastNonInteractiveValue -and
                $LastNonInteractiveWithinPeriod
            ) {
                $Member
            }
        }
    )

    # -----------------------------------------------------------------------
    # Run targeted non-interactive lookups
    # -----------------------------------------------------------------------

    $TargetedNonInteractiveByUserId = @{}
    $AllTargetedNonInteractiveSignIns = @()

    Write-Host ""
    Write-Host (
        "Running targeted non-interactive lookups for {0:N0} users..." -f
        $TargetUsers.Count
    ) -ForegroundColor Cyan

    $CurrentTarget = 0

    foreach ($TargetUser in $TargetUsers) {
        $CurrentTarget++

        Write-Host (
            "  [{0}/{1}] {2}" -f
            $CurrentTarget,
            $TargetUsers.Count,
            $TargetUser.UserPrincipalName
        ) -ForegroundColor Cyan

        try {
            $UserNonInteractiveSignIns = @(
                Get-TargetedNonInteractiveSignIns `
                    -UserId $TargetUser.Id `
                    -StartDate $StartDate
            )

            $TargetedNonInteractiveByUserId[
                $TargetUser.Id
            ] = @(
                $UserNonInteractiveSignIns
            )

            if ($UserNonInteractiveSignIns.Count -gt 0) {
                $AllTargetedNonInteractiveSignIns += @(
                    $UserNonInteractiveSignIns
                )
            }

            Write-Host (
                "    Retrieved {0:N0} successful non-interactive sign-ins." -f
                $UserNonInteractiveSignIns.Count
            ) -ForegroundColor Green
        }
        catch {
            Write-Warning (
                "Targeted lookup failed for {0}: {1}" -f
                $TargetUser.UserPrincipalName,
                $_.Exception.Message
            )

            $TargetedNonInteractiveByUserId[
                $TargetUser.Id
            ] = @()
        }
    }

    # -----------------------------------------------------------------------
    # Determine dynamic country columns
    # -----------------------------------------------------------------------

    $AllObservedCountries = @(
        @($NormalisedInteractiveSignIns.Country) +
        @($AllTargetedNonInteractiveSignIns.Country)
    )

    $KnownCountries = @(
        $AllObservedCountries |
            Where-Object {
                -not [string]::IsNullOrWhiteSpace($_) -and
                $_ -ne "Unknown"
            } |
            Sort-Object -Unique
    )

    $Countries = @(
        $KnownCountries
    )

    if ($AllObservedCountries -contains "Unknown") {
        $Countries += "Unknown"
    }

    # -----------------------------------------------------------------------
    # Select users for the internal report
    # -----------------------------------------------------------------------

    $IncludedUsersById = @{}

    # Include every enabled Member.
    foreach ($Member in $EnabledMembers) {
        $IncludedUsersById[$Member.Id] = $Member
    }

    # Include other user types when they have a successful interactive
    # sign-in during the report period.
    $RecentInteractiveUserIds = @(
        $NormalisedInteractiveSignIns.UserId |
            Sort-Object -Unique
    )

    foreach ($UserId in $RecentInteractiveUserIds) {
        if ($UserLookup.ContainsKey($UserId)) {
            $IncludedUsersById[$UserId] = $UserLookup[$UserId]
        }
    }

    # -----------------------------------------------------------------------
    # Build internal report
    # -----------------------------------------------------------------------

    Write-Host ""
    Write-Host "Building user and country summaries..." `
        -ForegroundColor Cyan

    $InternalReport = @(
        foreach ($User in $IncludedUsersById.Values) {
            $UserId = $User.Id

            if (
                [string]::IsNullOrWhiteSpace(
                    $User.DisplayName
                )
            ) {
                $UserName = $User.UserPrincipalName
            }
            else {
                $UserName = $User.DisplayName
            }

            $UserPrincipalName = $User.UserPrincipalName

            if (
                [string]::IsNullOrWhiteSpace(
                    $User.UserType
                )
            ) {
                $UserType = "Unknown"
            }
            else {
                $UserType = $User.UserType.Trim()
            }

            if (
                [string]::IsNullOrWhiteSpace(
                    $User.UsageLocation
                )
            ) {
                $UsageLocation = "Not Set"
            }
            else {
                $UsageLocation = $User.UsageLocation.Trim().ToUpperInvariant()
            }

            if ($null -eq $User.AccountEnabled) {
                $AccountEnabled = "Unknown"
            }
            elseif ($User.AccountEnabled -eq $true) {
                $AccountEnabled = "Yes"
            }
            else {
                $AccountEnabled = "No"
            }

            $LastInteractiveSignIn = ConvertTo-ReportDate `
                -DateValue $User.SignInActivity.LastSignInDateTime

            $LastNonInteractiveSignIn = ConvertTo-ReportDate `
                -DateValue `
                    $User.SignInActivity.LastNonInteractiveSignInDateTime

            if (
                $InteractiveSignInsByUserId.ContainsKey(
                    $UserId
                )
            ) {
                $UserInteractiveSignIns = @(
                    $InteractiveSignInsByUserId[$UserId]
                )
            }
            else {
                $UserInteractiveSignIns = @()
            }

            if (
                $TargetedNonInteractiveByUserId.ContainsKey(
                    $UserId
                )
            ) {
                $UserTargetedNonInteractiveSignIns = @(
                    $TargetedNonInteractiveByUserId[$UserId]
                )
            }
            else {
                $UserTargetedNonInteractiveSignIns = @()
            }

            $InteractiveSignInCount = (
                $UserInteractiveSignIns.Count
            )

            $TargetedNonInteractiveCount = (
                $UserTargetedNonInteractiveSignIns.Count
            )

            $RecentSignInCount = (
                $InteractiveSignInCount +
                $TargetedNonInteractiveCount
            )

            # Interactive records are preferred for country reporting.
            # Targeted non-interactive records are used when no successful
            # interactive records exist for the user during the period.
            if ($InteractiveSignInCount -gt 0) {
                $CountrySourceSignIns = @(
                    $UserInteractiveSignIns
                )

                $CountrySource = "Interactive"
            }
            elseif ($TargetedNonInteractiveCount -gt 0) {
                $CountrySourceSignIns = @(
                    $UserTargetedNonInteractiveSignIns
                )

                $CountrySource = "Targeted Non-Interactive"
            }
            else {
                $CountrySourceSignIns = @()
                $CountrySource = "No Recent Sign-ins"
            }

            $CountryCounts = @{}

            foreach (
                $CountryGroup in (
                    $CountrySourceSignIns |
                        Group-Object -Property Country
                )
            ) {
                $CountryCounts[$CountryGroup.Name] = (
                    $CountryGroup.Count
                )
            }

            $Row = [ordered]@{
                "User Name" = $UserName

                "User Principal Name" = $UserPrincipalName

                "User Type" = $UserType

                "Account Enabled" = $AccountEnabled

                "Usage Location" = $UsageLocation

                "Last Interactive Sign-in" = $LastInteractiveSignIn

                "Last Non-Interactive Sign-in" = $LastNonInteractiveSignIn

                "Interactive Sign-ins in Period" = (
                    $InteractiveSignInCount
                )

                "Targeted Non-Interactive Sign-ins" = (
                    $TargetedNonInteractiveCount
                )

                "Recent Sign-ins" = (
                    $RecentSignInCount
                )

                "Country Data Source" = $CountrySource
            }

            foreach ($Country in $Countries) {
                if ($CountryCounts.ContainsKey($Country)) {
                    $Row[$Country] = $CountryCounts[$Country]
                }
                else {
                    $Row[$Country] = 0
                }
            }

            # Unknown locations are excluded from unique-country count.
            $UserKnownCountries = @(
                $CountryCounts.Keys |
                    Where-Object {
                        $_ -ne "Unknown"
                    } |
                    Sort-Object -Unique
            )

            $Row["Unique Country Count"] = (
                $UserKnownCountries.Count
            )

            if ($UserKnownCountries.Count -eq 0) {
                $OutsideUsageLocation = "No Recent Sign-ins"
            }
            elseif (
                $UsageLocation -in @(
                    "Not Set"
                    "Unknown"
                )
            ) {
                $OutsideUsageLocation = "Unknown"
            }
            elseif (
                @(
                    $UserKnownCountries |
                        Where-Object {
                            $_ -ne $UsageLocation
                        }
                ).Count -gt 0
            ) {
                $OutsideUsageLocation = "Yes"
            }
            else {
                $OutsideUsageLocation = "No"
            }

            $Row["Sign-ins Outside Usage Location"] = (
                $OutsideUsageLocation
            )

            if ($UserKnownCountries.Count -eq 1) {
                $Row["Single Sign-in Country"] = (
                    $UserKnownCountries[0]
                )
            }
            else {
                $Row["Single Sign-in Country"] = $null
            }

            [PSCustomObject]$Row
        }
    )

    # -----------------------------------------------------------------------
    # Define report columns
    # -----------------------------------------------------------------------

    $CommonLeadingColumns = @(
        "User Name"
        "User Principal Name"
        "User Type"
        "Usage Location"
        "Last Interactive Sign-in"
        "Last Non-Interactive Sign-in"
        "Interactive Sign-ins in Period"
        "Targeted Non-Interactive Sign-ins"
        "Recent Sign-ins"
        "Country Data Source"
    )

    $MemberLeadingColumns = @(
        "User Name"
        "User Principal Name"
        "User Type"
        "Account Enabled"
        "Usage Location"
        "Last Interactive Sign-in"
        "Last Non-Interactive Sign-in"
        "Interactive Sign-ins in Period"
        "Targeted Non-Interactive Sign-ins"
        "Recent Sign-ins"
        "Country Data Source"
    )

    $TrailingColumns = @(
        "Unique Country Count"
        "Sign-ins Outside Usage Location"
    )

    $AllUsersColumns = @(
        $CommonLeadingColumns +
        $Countries +
        $TrailingColumns
    )

    $MemberColumns = @(
        $MemberLeadingColumns +
        $Countries +
        $TrailingColumns
    )

    # -----------------------------------------------------------------------
    # Split reports
    # -----------------------------------------------------------------------

    $AllUsersReport = @(
        $InternalReport
    )

    $MembersReport = @(
        $InternalReport |
            Where-Object {
                $_."User Type" -eq "Member" -and
                $_."Account Enabled" -eq "Yes"
            }
    )

    # Enabled Members with no successful interactive or targeted
    # non-interactive sign-ins during the reporting period.
    $InactiveUsersReport = @(
        $InternalReport |
            Where-Object {
                $_."User Type" -eq "Member" -and
                $_."Account Enabled" -eq "Yes" -and
                [int]$_."Recent Sign-ins" -eq 0
            }
    )

    $GuestsUnknownReport = @(
        $InternalReport |
            Where-Object {
                $_."User Type" -in @(
                    "Guest"
                    "Unknown"
                )
            }
    )

    # Users with at least one observed country that differs from
    # their configured Usage Location.
    $ExceptionsReport = @(
        $InternalReport |
            Where-Object {
                $_."Sign-ins Outside Usage Location" -eq "Yes"
            }
    )

    # Users with exactly one unique observed sign-in country, where that
    # country differs from their configured Usage Location.
    #
    # IMPORTANT:
    # The UsageLocation column in this report contains the OBSERVED
    # sign-in country, not the configured Entra UsageLocation property.
    $SingleCountryExceptionsReport = @(
        $InternalReport |
            Where-Object {
                $_."Unique Country Count" -eq 1 -and
                $_."Sign-ins Outside Usage Location" -eq "Yes"
            } |
            ForEach-Object {
                if (
                    -not [string]::IsNullOrWhiteSpace(
                        $_."Single Sign-in Country"
                    )
                ) {
                    [PSCustomObject]@{
                        UserPrincipalName = (
                            $_."User Principal Name"
                        )

                        UsageLocation = (
                            $_."Single Sign-in Country"
                        )
                    }
                }
            }
    )

    # Users with exactly two unique observed sign-in countries,
    # where one is AU.
    #
    # The UsageLocation column contains ONLY the non-AU observed country.
    $TwoCountryAustraliaReport = @(
        $InternalReport |
            Where-Object {
                $_."Unique Country Count" -eq 2
            } |
            ForEach-Object {
                $ObservedCountries = @()

                foreach ($Country in $Countries) {
                    if (
                        $Country -ne "Unknown" -and
                        [int]$_.$Country -gt 0
                    ) {
                        $ObservedCountries += $Country
                    }
                }

                if (
                    $ObservedCountries.Count -eq 2 -and
                    $ObservedCountries -contains "AU"
                ) {
                    $NonAUCountry = (
                        $ObservedCountries |
                            Where-Object {
                                $_ -ne "AU"
                            } |
                            Select-Object -First 1
                    )

                    if (
                        -not [string]::IsNullOrWhiteSpace(
                            $NonAUCountry
                        )
                    ) {
                        [PSCustomObject]@{
                            UserPrincipalName = (
                                $_."User Principal Name"
                            )

                            UsageLocation = $NonAUCountry
                        }
                    }
                }
            }
    )

    # -----------------------------------------------------------------------
    # Export reports
    # -----------------------------------------------------------------------

    Write-Host ""

    Export-ReportCsv `
        -Report $AllUsersReport `
        -Columns $AllUsersColumns `
        -Path $AllUsersOutputPath `
        -ReportName "All users report"

    Write-Host ""

    Export-ReportCsv `
        -Report $MembersReport `
        -Columns $MemberColumns `
        -Path $MembersOutputPath `
        -ReportName "Enabled Member report"

    Write-Host ""

    Export-ReportCsv `
        -Report $InactiveUsersReport `
        -Columns $MemberColumns `
        -Path $InactiveUsersOutputPath `
        -ReportName "Inactive users report"

    Write-Host ""

    Export-ReportCsv `
        -Report $GuestsUnknownReport `
        -Columns $AllUsersColumns `
        -Path $GuestsUnknownOutputPath `
        -ReportName "Guest or Unknown report"

    Write-Host ""

    Export-ReportCsv `
        -Report $ExceptionsReport `
        -Columns $AllUsersColumns `
        -Path $ExceptionsOutputPath `
        -ReportName "Usage location exceptions report"

    Write-Host ""

    $SingleCountryExceptionsReport |
        Sort-Object -Property UserPrincipalName |
        Export-Csv `
            -LiteralPath $SingleCountryExceptionsOutputPath `
            -NoTypeInformation `
            -Encoding UTF8 `
            -Force

    Write-Host (
        "Single-country exceptions report: {0:N0} users" -f
        $SingleCountryExceptionsReport.Count
    ) -ForegroundColor Green

    Write-Host "Output: $SingleCountryExceptionsOutputPath" `
        -ForegroundColor Green

    Write-Host ""

    $TwoCountryAustraliaReport |
        Sort-Object -Property UserPrincipalName |
        Export-Csv `
            -LiteralPath $TwoCountryAustraliaOutputPath `
            -NoTypeInformation `
            -Encoding UTF8 `
            -Force

    Write-Host (
        "Two-country AU report: {0:N0} users" -f
        $TwoCountryAustraliaReport.Count
    ) -ForegroundColor Green

    Write-Host "Output: $TwoCountryAustraliaOutputPath" `
        -ForegroundColor Green

    Write-Host ""
    Write-Host "All reports completed successfully." `
        -ForegroundColor Green
}
catch {
    Write-Host ""

    Write-Error (
        "The reports could not be completed: {0}" -f
        $_.Exception.Message
    )
}
finally {
    # -----------------------------------------------------------------------
    # Disconnect from Microsoft Graph
    # -----------------------------------------------------------------------

    if (Get-MgContext) {
        Write-Host ""
        Write-Host "Disconnecting from Microsoft Graph..." `
            -ForegroundColor Cyan

        Disconnect-MgGraph `
            -ErrorAction SilentlyContinue |
            Out-Null

        Write-Host "Disconnected from Microsoft Graph." `
            -ForegroundColor Green
    }
}
